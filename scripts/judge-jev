#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export JUDGE_JEV_ROOT="$ROOT"
RUNTIME_FILE="$ROOT/.judge-jev/runtime"

if [[ -n "${JUDGE_JEV_RUNTIME:-}" ]]; then
  RUNTIME="$JUDGE_JEV_RUNTIME"
elif [[ -f "$RUNTIME_FILE" ]]; then
  RUNTIME="$(tr -d '[:space:]' < "$RUNTIME_FILE")"
else
  RUNTIME=python
fi

# Human-facing commands live in the recommended Python frontend even when Rust is
# selected for machine `run`/`replay` calls. Python accepts its global verbosity
# flags anywhere, so find the command after those flags rather than assuming argv0.
COMMAND=""
previous=""
for arg in "$@"; do
  if [[ "$previous" == "--format" && "$arg" == "human" ]]; then
    RUNTIME=python
  fi
  previous="$arg"
  case "$arg" in --verbose|--debug) continue ;; esac
  [[ -n "$COMMAND" ]] || COMMAND="$arg"
done
case "$COMMAND" in
  init|doctor|reply|trajectory|input|explain|history) RUNTIME=python ;;
esac
if [[ $# -eq 0 && -t 0 ]]; then
  RUNTIME=python
fi

case "$RUNTIME" in
  python)
    command -v uv >/dev/null || { echo "judge-jev: uv is required; run scripts/setup.sh" >&2; exit 10; }
    PY_BIN="$ROOT/python/.venv/bin/judge-jev"
    # Always reconcile the environment with the lock. uv no-ops when it is fresh;
    # checking only for an old executable leaves stale dependencies after checkout.
    set +e
    uv sync --project "$ROOT/python" --locked --inexact --quiet >&2
    prep=$?
    set -e
    [[ "$prep" == 0 ]] || exit 10
    [[ -x "$PY_BIN" ]] || { echo "judge-jev: Python bootstrap did not install $PY_BIN" >&2; exit 10; }
    exec "$PY_BIN" "$@"
    ;;
  rust)
    BIN="$ROOT/rust/target/release/judge-jev"
    command -v cargo >/dev/null || { echo "judge-jev: cargo is required; run scripts/setup.sh" >&2; exit 10; }
    set +e
    cargo build --manifest-path "$ROOT/rust/Cargo.toml" --release --quiet >&2
    prep=$?
    set -e
    [[ "$prep" == 0 ]] || exit 10
    [[ -x "$BIN" ]] || { echo "judge-jev: Rust bootstrap did not build $BIN" >&2; exit 10; }
    exec "$BIN" "$@"
    ;;
  *)
    echo "Unknown runtime '$RUNTIME'. Run scripts/setup.sh first." >&2
    exit 10
    ;;
esac
