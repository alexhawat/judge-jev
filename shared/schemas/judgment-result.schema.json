{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexhawat/judge-jev/shared/schemas/judgment-result.schema.json",
  "title": "JudgmentResult",
  "description": "Structured output from judge-jev run/replay",
  "type": "object",
  "required": ["rubric_id", "verdict", "confidence", "stage", "model", "usage", "answers", "routing_reason", "mock"],
  "additionalProperties": false,
  "properties": {
    "rubric_id": { "type": "string" },
    "verdict": { "type": "string", "enum": ["pass", "fail", "review", "escalate", "skip"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stage": { "type": "string", "enum": ["screen", "profile", "locate", "score", "route"] },
    "model": { "type": "string" },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "noul"],
            "properties": {
              "type": { "const": "noul" },
              "noul": { "type": "number" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "choice", "confidence", "probabilities"],
            "properties": {
              "type": { "const": "choice" },
              "choice": { "type": "string" },
              "confidence": { "type": "number" },
              "probabilities": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "score", "confidence", "probabilities"],
            "properties": {
              "type": { "const": "score" },
              "score": { "type": "number" },
              "confidence": { "type": "number" },
              "probabilities": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "routing_reason": { "type": "string" },
    "mock": { "type": "boolean" },
    "request_id": { "type": ["string", "null"] }
  }
}
